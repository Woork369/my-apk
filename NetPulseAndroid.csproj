<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Используем базовую платформу net10.0-android -->
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>NetPulseAndroid</RootNamespace>
    <UseMaui>false</UseMaui>
    <ApplicationId>com.netpulse.android</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>
    <!-- Отключаем проверку устаревших ворклоадов на всякий случай -->
    <CheckEolWorkloads>false</CheckEolWorkloads>
  </PropertyGroup>

  <ItemGroup>
    <!-- Версии пакетов, совместимые с .NET 10 -->
    <PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.8.0" />
    <PackageReference Include="Xamarin.Google.Android.Material" Version="1.12.0.1" />
    <PackageReference Include="Xamarin.AndroidX.ViewPager2" Version="1.1.0.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!-- 
    ВНИМАНИЕ: Если у вас еще нет файла teapod-tun2socks.aar, 
    закомментируйте или удалите этот блок, иначе сборка упадет с ошибкой "файл не найден".
  -->
  <!--
  <ItemGroup>
    <AndroidLibrary Include="Jars\teapod-tun2socks.aar" />
  </ItemGroup>
  -->

  <ItemGroup>
    <AndroidResource Include="Resources\**\*" />
  </ItemGroup>
</Project>
